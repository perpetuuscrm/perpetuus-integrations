    "test:live": "node --test --test-concurrency=1 test/live.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perpetuuscrm/perpetuus-integrations.git",
    "directory": "pluga"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.1"
  }
