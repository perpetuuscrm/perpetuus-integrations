{
    "condition": "{{body.type == 'card.created'}}",
    "output": {
        "{{...}}": "{{omit(body.data, 'id', 'boardId', 'phaseId', 'phaseName', 'contactId', 'value', 'tagIds', 'tagNames', 'assigneeIds', 'dueDate', 'currentPhaseEnteredAt', 'lastMessageAt', 'createdAt', 'updatedAt', 'eventId', 'eventAt', 'webhookEventId')}}",
        "id": "{{body.data.documentId}}",
        "boardId": "{{ifempty(body.data.board.documentId, parameters.boardId)}}",
        "phaseId": "{{body.data.currentPhase.documentId}}",
        "phaseName": "{{body.data.currentPhase.name}}",
        "contactId": "{{body.data.contact.documentId}}",
        "value": "{{if(ifempty(body.data.value, '') == '', null, body.data.value * 1)}}",
        "tagIds": "{{map(body.data.tags, 'documentId')}}",
        "tagNames": "{{map(body.data.tags, 'name')}}",
        "assigneeIds": "{{map(body.data.assignees, 'documentId')}}",
        "dueDate": "{{if(body.data.dueDate, parseDate(body.data.dueDate, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.data.dueDate)}}",
        "currentPhaseEnteredAt": "{{if(body.data.currentPhaseEnteredAt, parseDate(body.data.currentPhaseEnteredAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.data.currentPhaseEnteredAt)}}",
        "lastMessageAt": "{{if(body.data.lastMessageAt, parseDate(body.data.lastMessageAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.data.lastMessageAt)}}",
        "createdAt": "{{if(body.data.createdAt, parseDate(body.data.createdAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.data.createdAt)}}",
        "updatedAt": "{{if(body.data.updatedAt, parseDate(body.data.updatedAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.data.updatedAt)}}",
        "eventId": "{{body.data.documentId}}",
        "eventAt": "{{if(ifempty(body.data.createdAt, body.timestamp), parseDate(ifempty(body.data.createdAt, body.timestamp), 'YYYY-MM-DDTHH:mm:ss.SSSZ'), ifempty(body.data.createdAt, body.timestamp))}}",
        "webhookEventId": "{{body.id}}"
    }
}
