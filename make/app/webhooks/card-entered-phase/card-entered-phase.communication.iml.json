{
    "condition": "{{(body.type == 'card.created' || body.type == 'card.phase_changed') && (ifempty(parameters.phaseId, '') == '' || ifempty(body.data.toPhase.documentId, body.data.currentPhase.documentId) == parameters.phaseId)}}",
    "output": {
        "{{...}}": "{{omit(body.data, 'id', 'boardId', 'phaseId', 'phaseName', 'contactId', 'value', 'tagIds', 'tagNames', 'assigneeIds', 'dueDate', 'currentPhaseEnteredAt', 'lastMessageAt', 'createdAt', 'updatedAt', 'previousPhaseId', 'previousPhaseName', 'eventId', 'eventAt', 'webhookEventId')}}",
        "id": "{{body.data.documentId}}",
        "boardId": "{{ifempty(body.data.board.documentId, parameters.boardId)}}",
        "phaseId": "{{ifempty(body.data.toPhase.documentId, body.data.currentPhase.documentId)}}",
        "phaseName": "{{ifempty(body.data.toPhase.name, body.data.currentPhase.name)}}",
        "contactId": "{{body.data.contact.documentId}}",
        "value": "{{if(ifempty(body.data.value, '') == '', null, body.data.value * 1)}}",
        "tagIds": "{{map(body.data.tags, 'documentId')}}",
        "tagNames": "{{map(body.data.tags, 'name')}}",
        "assigneeIds": "{{map(body.data.assignees, 'documentId')}}",
        "dueDate": "{{if(body.data.dueDate, parseDate(body.data.dueDate, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.data.dueDate)}}",
        "currentPhaseEnteredAt": "{{if(body.data.currentPhaseEnteredAt, parseDate(body.data.currentPhaseEnteredAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.data.currentPhaseEnteredAt)}}",
        "lastMessageAt": "{{if(body.data.lastMessageAt, parseDate(body.data.lastMessageAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.data.lastMessageAt)}}",
        "createdAt": "{{if(body.data.createdAt, parseDate(body.data.createdAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.data.createdAt)}}",
        "updatedAt": "{{if(body.data.updatedAt, parseDate(body.data.updatedAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.data.updatedAt)}}",
        "previousPhaseId": "{{body.data.fromPhase.documentId}}",
        "previousPhaseName": "{{body.data.fromPhase.name}}",
        "eventId": "{{body.data.documentId}}:{{ifempty(body.data.toPhase.documentId, body.data.currentPhase.documentId)}}:{{ifempty(body.data.currentPhaseEnteredAt, body.timestamp)}}",
        "eventAt": "{{if(ifempty(body.data.currentPhaseEnteredAt, body.timestamp), parseDate(ifempty(body.data.currentPhaseEnteredAt, body.timestamp), 'YYYY-MM-DDTHH:mm:ss.SSSZ'), ifempty(body.data.currentPhaseEnteredAt, body.timestamp))}}",
        "webhookEventId": "{{body.id}}"
    }
}
