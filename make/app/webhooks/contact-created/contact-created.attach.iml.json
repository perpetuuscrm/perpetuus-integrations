{
    "url": "/webhook-subscriptions",
    "method": "POST",
    "body": {
        "url": "{{webhook.url}}",
        "events": [
            "contact.created"
        ],
        "origin": "make",
        "description": "Make: Watch new contacts (instant)"
    },
    "response": {
        "data": {
            "externalHookId": "{{body.data.id}}"
        }
    },
    "log": {
        "sanitize": [
            "request.headers.authorization",
            "response.body.data.secret"
        ]
    }
}
