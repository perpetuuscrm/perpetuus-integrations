{
    "url": "/tasks",
    "method": "GET",
    "qs": {
        "filters[completedAt][$notNull]": "true",
        "filters[completedAt][$gte]": "{{formatDate(ifempty(data.lastDate, '1970-01-01T00:00:00.000Z'), 'YYYY-MM-DDTHH:mm:ss.SSS[Z]', 'UTC')}}",
        "filters[board][documentId]": "{{ifempty(parameters.boardId, undefined)}}",
        "sort": "completedAt:desc",
        "limit": 100
    },
    "response": {
        "limit": "{{parameters.limit}}",
        "iterate": "{{ifempty(body.data, body)}}",
        "output": {
            "id": "{{item.documentId}}",
            "name": "{{item.name}}",
            "description": "{{item.description}}",
            "type": "{{item.type}}",
            "priority": "{{item.priority}}",
            "status": "{{item.taskStatus}}",
            "dueDate": "{{item.dueDate}}",
            "completedAt": "{{item.completedAt}}",
            "cardId": "{{item.card.documentId}}",
            "cardTitle": "{{item.card.title}}",
            "assigneeIds": "{{map(item.assignees, 'documentId')}}",
            "createdAt": "{{item.createdAt}}",
            "updatedAt": "{{item.updatedAt}}",
            "eventId": "{{item.documentId}}:{{item.completedAt}}",
            "eventAt": "{{item.completedAt}}"
        },
        "trigger": {
            "type": "date",
            "order": "desc",
            "id": "{{item.documentId}}:{{item.completedAt}}",
            "date": "{{item.completedAt}}"
        }
    },
    "pagination": {
        "qs": {
            "offset": "{{(pagination.page - 1) * 100}}"
        },
        "condition": "{{length(ifempty(body.data, body)) == 100}}"
    }
}
