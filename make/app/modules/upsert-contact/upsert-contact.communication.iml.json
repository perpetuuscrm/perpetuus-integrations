{
    "url": "/contacts/upsert",
    "method": "POST",
    "body": {
        "data": {
            "name": "{{parameters.name}}",
            "email": "{{parameters.email}}",
            "phone": "{{parameters.phone}}",
            "contact_type": "{{switch(parameters.contactType, 'person', 'pessoa', 'company', 'empresa')}}",
            "cpf": "{{parameters.cpf}}",
            "cnpj": "{{parameters.cnpj}}",
            "address": "{{parameters.address}}",
            "city": "{{parameters.city}}",
            "state": "{{parameters.state}}",
            "country": "{{parameters.country}}",
            "postal_code": "{{parameters.postalCode}}",
            "customFields": "{{if(length(ifempty(parameters.customFields, emptyarray)) > 0, toCollection(parameters.customFields, 'key', 'value'), undefined)}}"
        },
        "matchBy": "{{parameters.matchBy}}"
    },
    "response": {
        "error": {
            "500": {
                "type": "RuntimeError",
                "message": "[{{statusCode}}] Perpetuus server error (HTTP {{statusCode}}). Try again later. The request was not repeated automatically to avoid duplicates; check Perpetuus before running it again."
            },
            "502": {
                "type": "RuntimeError",
                "message": "[{{statusCode}}] Perpetuus server error (HTTP {{statusCode}}). Try again later. The request was not repeated automatically to avoid duplicates; check Perpetuus before running it again."
            },
            "503": {
                "type": "RuntimeError",
                "message": "[{{statusCode}}] Perpetuus server error (HTTP {{statusCode}}). Try again later. The request was not repeated automatically to avoid duplicates; check Perpetuus before running it again."
            },
            "504": {
                "type": "RuntimeError",
                "message": "[{{statusCode}}] Perpetuus server error (HTTP {{statusCode}}). Try again later. The request was not repeated automatically to avoid duplicates; check Perpetuus before running it again."
            }
        },
        "output": {
            "{{...}}": "{{omit(body.data, 'id', 'contactType', 'createdAt', 'updatedAt', 'created', 'matchedBy', 'otherMatchIds')}}",
            "id": "{{body.data.documentId}}",
            "contactType": "{{switch(body.data.contact_type, 'pessoa', 'person', 'empresa', 'company', 'person', 'person', 'company', 'company')}}",
            "createdAt": "{{if(body.data.createdAt, parseDate(body.data.createdAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.data.createdAt)}}",
            "updatedAt": "{{if(body.data.updatedAt, parseDate(body.data.updatedAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.data.updatedAt)}}",
            "created": "{{body.meta.created == true}}",
            "matchedBy": "{{body.meta.matchedBy}}",
            "otherMatchIds": "{{ifempty(body.meta.otherMatches, emptyarray)}}"
        }
    }
}
