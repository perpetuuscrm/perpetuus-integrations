{
    "url": "/boards/{{parameters.boardId}}/cards",
    "method": "GET",
    "qs": {
        "filters[title][$containsi]": "{{ifempty(parameters.query, undefined)}}",
        "filters[currentPhase][documentId][$eq]": "{{ifempty(parameters.phaseId, undefined)}}",
        "filters[contact][documentId][$eq]": "{{ifempty(parameters.contactId, undefined)}}",
        "sort": "updatedAt:desc",
        "stats": "false",
        "pagination[pageSize]": 100,
        "populate[contact]": "true",
        "populate[currentPhase]": "true",
        "populate[tags]": "true",
        "populate[fieldData][populate][0]": "field"
    },
    "response": {
        "limit": "{{ifempty(parameters.limit, 100)}}",
        "iterate": "{{body.data}}",
        "output": {
            "{{...}}": "{{omit(item, 'id', 'boardId', 'phaseId', 'phaseName', 'contactId', 'value', 'tagIds', 'tagNames', 'assigneeIds', 'dueDate', 'currentPhaseEnteredAt', 'lastMessageAt', 'createdAt', 'updatedAt')}}",
            "id": "{{item.documentId}}",
            "boardId": "{{ifempty(item.board.documentId, parameters.boardId)}}",
            "phaseId": "{{item.currentPhase.documentId}}",
            "phaseName": "{{item.currentPhase.name}}",
            "contactId": "{{item.contact.documentId}}",
            "value": "{{if(ifempty(item.value, '') == '', null, item.value * 1)}}",
            "tagIds": "{{map(item.tags, 'documentId')}}",
            "tagNames": "{{map(item.tags, 'name')}}",
            "assigneeIds": "{{map(item.assignees, 'documentId')}}",
            "dueDate": "{{if(item.dueDate, parseDate(item.dueDate, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), item.dueDate)}}",
            "currentPhaseEnteredAt": "{{if(item.currentPhaseEnteredAt, parseDate(item.currentPhaseEnteredAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), item.currentPhaseEnteredAt)}}",
            "lastMessageAt": "{{if(item.lastMessageAt, parseDate(item.lastMessageAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), item.lastMessageAt)}}",
            "createdAt": "{{if(item.createdAt, parseDate(item.createdAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), item.createdAt)}}",
            "updatedAt": "{{if(item.updatedAt, parseDate(item.updatedAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), item.updatedAt)}}"
        }
    },
    "pagination": {
        "qs": {
            "pagination[page]": "{{pagination.page}}"
        },
        "condition": "{{body.meta.pagination.page < body.meta.pagination.pageCount}}"
    }
}
