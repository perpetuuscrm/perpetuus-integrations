[
    {
        "url": "/boards/{{parameters.boardId}}/cards",
        "method": "POST",
        "body": {
            "data": {
                "fields": {
                    "{{...}}": "{{toCollection(merge(toArray(omit(parameters, 'boardId', 'title', 'phaseId', 'contactId', 'tagIds', 'value', 'dueDate', 'description', 'assigneeIds', 'fields')), ifempty(parameters.fields, emptyarray)), 'key', 'value')}}",
                    "name": "{{parameters.title}}"
                },
                "contact": "{{parameters.contactId}}",
                "tags": "{{parameters.tagIds}}",
                "assignees": "{{parameters.assigneeIds}}",
                "value": "{{parameters.value}}",
                "dueDate": "{{if(parameters.dueDate, formatDate(parameters.dueDate, 'YYYY-MM-DDTHH:mm:ss.SSS[Z]', 'UTC'), undefined)}}",
                "description": "{{parameters.description}}"
            }
        },
        "response": {
            "error": {
                "500": {
                    "type": "RuntimeError",
                    "message": "[{{statusCode}}] Perpetuus server error (HTTP {{statusCode}}). Try again later. The request was not repeated automatically to avoid duplicates; check Perpetuus before running it again."
                },
                "502": {
                    "type": "RuntimeError",
                    "message": "[{{statusCode}}] Perpetuus server error (HTTP {{statusCode}}). Try again later. The request was not repeated automatically to avoid duplicates; check Perpetuus before running it again."
                },
                "503": {
                    "type": "RuntimeError",
                    "message": "[{{statusCode}}] Perpetuus server error (HTTP {{statusCode}}). Try again later. The request was not repeated automatically to avoid duplicates; check Perpetuus before running it again."
                },
                "504": {
                    "type": "RuntimeError",
                    "message": "[{{statusCode}}] Perpetuus server error (HTTP {{statusCode}}). Try again later. The request was not repeated automatically to avoid duplicates; check Perpetuus before running it again."
                }
            },
            "temp": {
                "cardId": "{{ifempty(body.data.documentId, body.documentId)}}",
                "initialPhaseId": "{{ifempty(body.data.currentPhase.documentId, body.currentPhase.documentId)}}"
            }
        }
    },
    {
        "condition": "{{parameters.phaseId && parameters.phaseId != temp.initialPhaseId}}",
        "url": "/boards/{{parameters.boardId}}/cards/{{temp.cardId}}",
        "method": "PUT",
        "body": {
            "data": {
                "currentPhase": "{{parameters.phaseId}}"
            }
        },
        "response": {
            "error": {
                "500": {
                    "type": "RuntimeError",
                    "message": "[{{statusCode}}] Perpetuus server error (HTTP {{statusCode}}). Try again later. The request was not repeated automatically to avoid duplicates; check Perpetuus before running it again."
                },
                "502": {
                    "type": "RuntimeError",
                    "message": "[{{statusCode}}] Perpetuus server error (HTTP {{statusCode}}). Try again later. The request was not repeated automatically to avoid duplicates; check Perpetuus before running it again."
                },
                "503": {
                    "type": "RuntimeError",
                    "message": "[{{statusCode}}] Perpetuus server error (HTTP {{statusCode}}). Try again later. The request was not repeated automatically to avoid duplicates; check Perpetuus before running it again."
                },
                "504": {
                    "type": "RuntimeError",
                    "message": "[{{statusCode}}] Perpetuus server error (HTTP {{statusCode}}). Try again later. The request was not repeated automatically to avoid duplicates; check Perpetuus before running it again."
                }
            }
        }
    },
    {
        "url": "/boards/{{parameters.boardId}}/cards/{{temp.cardId}}",
        "method": "GET",
        "qs": {
            "populate[contact]": "true",
            "populate[currentPhase]": "true",
            "populate[tags]": "true",
            "populate[fieldData][populate][0]": "field"
        },
        "response": {
            "output": {
                "{{...}}": "{{omit(body, 'id', 'boardId', 'phaseId', 'phaseName', 'contactId', 'value', 'tagIds', 'tagNames', 'assigneeIds', 'dueDate', 'currentPhaseEnteredAt', 'lastMessageAt', 'createdAt', 'updatedAt')}}",
                "id": "{{body.documentId}}",
                "boardId": "{{ifempty(body.board.documentId, parameters.boardId)}}",
                "phaseId": "{{body.currentPhase.documentId}}",
                "phaseName": "{{body.currentPhase.name}}",
                "contactId": "{{body.contact.documentId}}",
                "value": "{{if(ifempty(body.value, '') == '', null, body.value * 1)}}",
                "tagIds": "{{map(body.tags, 'documentId')}}",
                "tagNames": "{{map(body.tags, 'name')}}",
                "assigneeIds": "{{map(body.assignees, 'documentId')}}",
                "dueDate": "{{if(body.dueDate, parseDate(body.dueDate, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.dueDate)}}",
                "currentPhaseEnteredAt": "{{if(body.currentPhaseEnteredAt, parseDate(body.currentPhaseEnteredAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.currentPhaseEnteredAt)}}",
                "lastMessageAt": "{{if(body.lastMessageAt, parseDate(body.lastMessageAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.lastMessageAt)}}",
                "createdAt": "{{if(body.createdAt, parseDate(body.createdAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.createdAt)}}",
                "updatedAt": "{{if(body.updatedAt, parseDate(body.updatedAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.updatedAt)}}"
            }
        }
    }
]
