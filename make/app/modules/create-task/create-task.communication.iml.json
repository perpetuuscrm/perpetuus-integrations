[
    {
        "url": "/tasks",
        "method": "POST",
        "body": {
            "data": {
                "name": "{{parameters.name}}",
                "card": "{{parameters.cardId}}",
                "board": "{{if(parameters.cardId, undefined, parameters.boardId)}}",
                "description": "{{parameters.description}}",
                "dueDate": "{{if(parameters.dueDate, formatDate(parameters.dueDate, 'YYYY-MM-DDTHH:mm:ss.SSS[Z]', 'UTC'), undefined)}}",
                "type": "{{parameters.type}}",
                "priority": "{{parameters.priority}}",
                "taskStatus": "{{parameters.status}}",
                "assignees": "{{parameters.assigneeIds}}"
            }
        },
        "response": {
            "error": {
                "500": {
                    "type": "RuntimeError",
                    "message": "[{{statusCode}}] Perpetuus server error (HTTP {{statusCode}}). Try again later. The request was not repeated automatically to avoid duplicates; check Perpetuus before running it again."
                },
                "502": {
                    "type": "RuntimeError",
                    "message": "[{{statusCode}}] Perpetuus server error (HTTP {{statusCode}}). Try again later. The request was not repeated automatically to avoid duplicates; check Perpetuus before running it again."
                },
                "503": {
                    "type": "RuntimeError",
                    "message": "[{{statusCode}}] Perpetuus server error (HTTP {{statusCode}}). Try again later. The request was not repeated automatically to avoid duplicates; check Perpetuus before running it again."
                },
                "504": {
                    "type": "RuntimeError",
                    "message": "[{{statusCode}}] Perpetuus server error (HTTP {{statusCode}}). Try again later. The request was not repeated automatically to avoid duplicates; check Perpetuus before running it again."
                }
            },
            "temp": {
                "taskId": "{{ifempty(body.data.documentId, body.documentId)}}"
            }
        }
    },
    {
        "url": "/tasks/{{temp.taskId}}",
        "method": "GET",
        "qs": {
            "populate[card]": "true",
            "populate[assignees]": "true"
        },
        "response": {
            "output": {
                "{{...}}": "{{omit(body, 'id', 'cardId', 'assigneeIds', 'dueDate', 'completedAt', 'createdAt', 'updatedAt')}}",
                "id": "{{body.documentId}}",
                "cardId": "{{ifempty(body.card.documentId, parameters.cardId)}}",
                "assigneeIds": "{{map(body.assignees, 'documentId')}}",
                "dueDate": "{{if(body.dueDate, parseDate(body.dueDate, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.dueDate)}}",
                "completedAt": "{{if(body.completedAt, parseDate(body.completedAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.completedAt)}}",
                "createdAt": "{{if(body.createdAt, parseDate(body.createdAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.createdAt)}}",
                "updatedAt": "{{if(body.updatedAt, parseDate(body.updatedAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), body.updatedAt)}}"
            }
        }
    }
]
