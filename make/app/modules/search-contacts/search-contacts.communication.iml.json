{
    "temp": {
        "digits": "{{replace(ifempty(parameters.value, ''), '/[^0-9]/g', '')}}"
    },
    "condition": "{{parameters.searchBy != 'phone' || length(temp.digits) > 0}}",
    "url": "/contacts",
    "method": "GET",
    "qs": {
        "filters[email][$eqi]": "{{if(parameters.searchBy == 'email', trim(parameters.value), undefined)}}",
        "quickSearch": "{{switch(parameters.searchBy, 'phone', if(length(temp.digits) >= 12 && substring(temp.digits, 0, 2) == '55', substring(temp.digits, 2, length(temp.digits)), temp.digits), 'text', parameters.value)}}",
        "sort": "{{if(parameters.searchBy == 'text', 'updatedAt:desc', 'createdAt:asc')}}",
        "pagination[pageSize]": 100
    },
    "response": {
        "limit": "{{ifempty(parameters.limit, 100)}}",
        "iterate": "{{body.data}}",
        "output": {
            "{{...}}": "{{omit(item, 'id', 'contactType', 'createdAt', 'updatedAt')}}",
            "id": "{{item.documentId}}",
            "contactType": "{{switch(item.contact_type, 'pessoa', 'person', 'empresa', 'company', 'person', 'person', 'company', 'company')}}",
            "createdAt": "{{if(item.createdAt, parseDate(item.createdAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), item.createdAt)}}",
            "updatedAt": "{{if(item.updatedAt, parseDate(item.updatedAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), item.updatedAt)}}"
        }
    },
    "pagination": {
        "qs": {
            "pagination[page]": "{{pagination.page}}"
        },
        "condition": "{{body.meta.pagination.page < body.meta.pagination.pageCount}}"
    }
}
