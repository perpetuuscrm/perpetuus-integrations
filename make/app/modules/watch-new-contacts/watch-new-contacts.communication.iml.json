{
    "url": "/contacts",
    "method": "GET",
    "qs": {
        "filters[createdAt][$gte]": "{{formatDate(ifempty(data.lastDate, '1970-01-01T00:00:00.000Z'), 'YYYY-MM-DDTHH:mm:ss.SSS[Z]', 'UTC')}}",
        "sort": "createdAt:desc",
        "pagination[pageSize]": 100
    },
    "response": {
        "limit": "{{parameters.limit}}",
        "iterate": "{{body.data}}",
        "output": {
            "{{...}}": "{{omit(item, 'id', 'contactType', 'createdAt', 'updatedAt', 'eventId', 'eventAt')}}",
            "id": "{{item.documentId}}",
            "contactType": "{{switch(item.contact_type, 'pessoa', 'person', 'empresa', 'company', 'person', 'person', 'company', 'company')}}",
            "createdAt": "{{if(item.createdAt, parseDate(item.createdAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), item.createdAt)}}",
            "updatedAt": "{{if(item.updatedAt, parseDate(item.updatedAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), item.updatedAt)}}",
            "eventId": "{{item.documentId}}",
            "eventAt": "{{if(item.createdAt, parseDate(item.createdAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ'), item.createdAt)}}"
        },
        "trigger": {
            "type": "date",
            "order": "desc",
            "id": "{{item.documentId}}",
            "date": "{{parseDate(item.createdAt, 'YYYY-MM-DDTHH:mm:ss.SSSZ')}}"
        }
    },
    "pagination": {
        "qs": {
            "pagination[page]": "{{pagination.page}}"
        },
        "condition": "{{body.meta.pagination.page < body.meta.pagination.pageCount}}"
    }
}
